# Copy this file to .env and edit. .env is git-ignored.

# Signs the login session. Optional: if you leave this as change-me (or under 16 characters) the app makes
# a random key once and keeps it in instance/secret_key. To choose your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Used to decide what "today" means for follow-ups and monthly totals.
TIMEZONE=Asia/Kolkata

# Set to 1 once the site is served over HTTPS (PythonAnywhere does this by default).
SESSION_COOKIE_SECURE=0

# Optional. Defaults to a SQLite file at instance/leads.db
# DATABASE_URL=sqlite:////absolute/path/to/leads.db

# Encrypts phone/email/address columns at rest, so the database file isn't readable as plain text
# if it ever leaks. Optional for local dev only (the app makes a random key once in
# instance/field_encryption_key). On any server that holds real data, set this explicitly - unlike
# SECRET_KEY, this key must never change once data has been encrypted with it, or that data becomes
# permanently unreadable. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=

# ---- Only on the PythonAnywhere server (see README, "Deploy") ----

# Switches on the /deploy webhook that GitHub calls after each push to main. At least 20 random characters, the
# same value as the DEPLOY_SECRET secret in GitHub. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# DEPLOY_SECRET=

# The WSGI file PythonAnywhere shows on the Web tab. The webhook touches it to reload the site.
# WSGI_RELOAD_FILE=/var/www/YOURNAME_pythonanywhere_com_wsgi.py

# Normally not needed: the Python used to run database migrations during a deploy. It is found from the
# virtualenv automatically; set this only if a deploy reports that it cannot find Python.
# PYTHON_BIN=/home/YOURNAME/.virtualenvs/grtechno/bin/python
